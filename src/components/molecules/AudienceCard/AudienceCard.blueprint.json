    "targetSlug": { "type": "string", "required": false },
    "onClick": { "type": "() => void", "required": false }
  },
  "variants": ["symptom", "role"],
  "states": ["default", "hover", "focus", "active"],
  "wcag_criteria": ["1.3.1", "1.4.3", "2.1.1", "2.4.7", "4.1.2"],
