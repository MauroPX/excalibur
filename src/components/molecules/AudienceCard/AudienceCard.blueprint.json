  ],
  "blueprint_gate": {
    "BH-1": "PASS — tokens existen en DESIGN_TOKENS.json",
    "BH-2": "PASS — WCAG 1.3.1, 1.4.3, 2.1.1, 2.4.7, 4.1.2 válidos en 2.2",
    "BH-3": "PASS — MUI v6, next-intl versiones fijadas en package.json",
    "BH-4": "PASS — 0 any en props_contract",
    "BH-5": "PASS — scope es nivel molecule (compone átomos, sin lógica de negocio)",
    "BH-6": "PASS — sin PENDIENTE sin resolver"
  }
