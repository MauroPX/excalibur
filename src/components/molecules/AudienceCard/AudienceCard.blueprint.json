    "audienceCard.role.ariaLabel"
  ],
  "spec_criteria": [
    "CA-001: variante symptom con título + descripción + ícono",
    "CA-002: variante role con título + descripción + ícono",
    "CA-003: CTA Button atom variante text|outlined",
    "CA-004: Tag atom con etiqueta de audiencia",
    "CA-005: hover elevación M3 surface-container-high + 200ms",
    "CA-006: WCAG 2.2 AA — contraste + focus visible + role=article + aria-label",
    "CA-007: 0 hex hardcoded — solo tokens M3",
    "CA-008: data-atomic='molecule' data-component='AudienceCard' en root",
    "CA-009: clickable completo con teclado (Enter/Space en article)",
    "CA-010: ES/EN next-intl useTranslations"
  ],
  "out_of_scope": [
    "No hace fetch de datos (los recibe por props)",
